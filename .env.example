# Chef RAG v2 - Configurações de Ambiente
# ======================================

# OpenAI API Key (obrigatório)
OPENAI_API_KEY=your_openai_api_key_here

# Google API Key (opcional)
GOOGLE_API_KEY=your_google_api_key_here

# LangChain/LangSmith Configuration (opcional)
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=chef-rag-v2
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# AI Provider Configuration
AI_PROVIDER=openai

# Instruções:
# 1. Renomeie este arquivo para .env
# 2. Substitua os valores pelos seus API keys reais
# 3. Para LangSmith: registre-se em https://smith.langchain.com/
# 4. Para OpenAI: obtenha sua API key em https://platform.openai.com/api-keys